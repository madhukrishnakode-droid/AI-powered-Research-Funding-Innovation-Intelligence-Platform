# ---- Radial OAuth configuration -------------------------------------------
# Copy to .env (client) and/or server/.env (server secrets).

# Google OAuth client ID (https://console.cloud.google.com/apis/credentials)
# Add http://localhost:5173/auth/callback to Authorized redirect URIs.
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth client ID (https://github.com/settings/developers)
# Add http://localhost:5173/auth/callback to the callback URL.
VITE_GITHUB_CLIENT_ID=

# OAuth exchange endpoint. Defaults to the Vite proxy in development.
VITE_OAUTH_EXCHANGE_URL=/api/oauth/exchange

# --- Server-side secrets (used by the exchange server, never in the browser) ---
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_SECRET=
PORT=3001
