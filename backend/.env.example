# Project Details
PROJECT_NAME="Research Funding & Innovation Intelligence Platform"
API_V1_STR="/api/v1"

# Security Configurations
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY="your-super-secret-jwt-signing-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configurations (MySQL Connection Settings)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="REDACTED_DB_PASSWORD"
DB_NAME="research_platform"

# CORS Configurations
# Parsed as a JSON-encoded list of strings
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'
